{
  "name": "social-chirp",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "A small Twitter-like social timeline, migrated from Vue 2 to Vue 3.",
  "author": "Sonia Benítez <sbenitezma@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && start-server-and-test \"vite preview --host 127.0.0.1 --port 4173\" http://127.0.0.1:4173 \"cypress run\"",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/ tests/ cypress/"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "pinia": "^3.0.3",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1",
    "vuetify": "^3.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.6",
    "cypress": "^14.5.0",
    "eslint": "^9.30.0",
    "eslint-plugin-cypress": "^5.1.0",
    "eslint-plugin-vue": "^10.2.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "sass-embedded": "^1.89.2",
    "start-server-and-test": "^3.0.13",
    "vite": "^7.0.0",
    "vite-plugin-vuetify": "^2.1.1",
    "vitest": "^3.2.4"
  }
}
